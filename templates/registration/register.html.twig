{% extends 'base.html.twig' %}

{% block title %}Créer un compte{% endblock %}

{% block body %}
    <div class="auth-shell mx-auto">
        <div class="section-heading section-heading--compact text-start">
            <p class="eyebrow">Nouveau client</p>
            <h1>Créer un compte</h1>
            <p>Une inscription rapide pour suivre tes produits favoris.</p>
        </div>

        <div class="auth-card">
            {{ form_start(registrationForm, {'attr': {'class': 'auth-form'}}) }}
                <div class="mb-3">
                    {{ form_label(registrationForm.email, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(registrationForm.email, {'attr': {'class': 'form-control form-control-lg'}}) }}
                    {{ form_errors(registrationForm.email) }}
                </div>

                <div class="mb-3">
                    {{ form_label(registrationForm.plainPassword, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'form-control form-control-lg'}}) }}
                    {{ form_errors(registrationForm.plainPassword) }}
                </div>

                <div class="mb-4">
                    {{ form_row(registrationForm.agreeTerms, {'label_attr': {'class': 'form-check-label'}}) }}
                </div>

                <button type="submit" class="btn btn-brand btn-lg w-100">Créer mon compte</button>
            {{ form_end(registrationForm) }}

            <div class="mt-3 text-center small">
                <a href="{{ path('app_login') }}">Déjà un compte ? Se connecter</a>
            </div>
        </div>
    </div>
{% endblock %}
