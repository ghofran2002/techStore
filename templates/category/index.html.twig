{% extends 'base.html.twig' %}

{% block title %}Catégories{% endblock %}

{% block body %}
    <div class="section-heading section-heading--compact">
        <p class="eyebrow">Catégories</p>
        <h1>Choisir une catégorie</h1>
        <p>Parcourir les produits par thème.</p>
    </div>

    <div class="row g-4">
        {% for category in categories %}
            <div class="col-12 col-md-6 col-lg-4">
                <a href="{{ path('category_show', {id: category.id}) }}" class="card text-reset text-decoration-none p-3">
                    <h3 class="h5 mb-1">{{ category.name }}</h3>
                    <p class="text-muted mb-0">{{ category.getProducts()|length }} produits</p>
                </a>
            </div>
        {% else %}
            <div class="col-12 text-center">
                <p class="text-muted">Aucune catégorie trouvée.</p>
            </div>
        {% endfor %}
    </div>
{% endblock %}
