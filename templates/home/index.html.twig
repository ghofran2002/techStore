{% extends 'base.html.twig' %}

{% block title %}Accueil - TechStore{% endblock %}

{% block body %}
    <section class="hero-panel mb-5">
        <div class="hero-panel__content">
            <p class="eyebrow">Boutique tech moderne</p>
            <h1>Des produits sélectionnés pour aller droit à l’essentiel.</h1>
            <p class="lead">Parcourez une vitrine claire, rapide et adaptée au mobile pour découvrir les nouveautés Tech Store.</p>
            <div class="d-flex flex-column flex-sm-row gap-3 mt-4">
                <a href="{{ path('product_index') }}" class="btn btn-brand btn-lg">Découvrir les produits</a>
                <a href="{{ path('app_register') }}" class="btn btn-outline-light btn-lg">Créer un compte</a>
            </div>
        </div>
        <div class="hero-panel__stats">
            <div class="stat-card">
                <span class="stat-card__value">50+</span>
                <span class="stat-card__label">produits générés</span>
            </div>
            <div class="stat-card">
                <span class="stat-card__value">Responsive</span>
                <span class="stat-card__label">navigation fluide</span>
            </div>
            <div class="stat-card">
                <span class="stat-card__value">Symfony</span>
                <span class="stat-card__label">Twig, Doctrine, AssetMapper</span>
            </div>
        </div>
    </section>

    <div class="section-heading">
        <p class="eyebrow">Nouveautés</p>
        <h2>Les derniers produits ajoutés</h2>
    </div>

    <div class="row g-4">
        {% for product in products %}
            <div class="col-12 col-sm-6 col-xl-3">
                <article class="card product-card h-100">
                    <div class="product-card__media">
                        <img src="{{ product.image }}" class="card-img-top" alt="{{ product.name }}">
                    </div>
                    <div class="card-body d-flex flex-column">
                        <p class="product-card__category mb-2">Produit premium</p>
                        <h3 class="card-title h5 mb-2">{{ product.name }}</h3>
                        <p class="product-card__price mb-4">{{ product.price }} DT</p>
                        <a href="{{ path('product_show', {id: product.id}) }}" class="btn btn-brand mt-auto">Voir le détail</a>
                    </div>
                </article>
            </div>
        {% else %}
            <div class="col-12">
                <div class="empty-state text-center">
                    <h3>Aucun produit disponible</h3>
                    <p class="mb-0">Les produits apparaîtront ici dès qu’ils seront ajoutés à la base.</p>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
