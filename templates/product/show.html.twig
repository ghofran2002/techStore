{% extends 'base.html.twig' %}

{% block title %}{{ product.name }}{% endblock %}

{% block body %}
    <div class="section-heading section-heading--compact text-start">
        <p class="eyebrow">Fiche produit</p>
        <h1>{{ product.name }}</h1>
        {% if product.category %}
            <p class="mb-2"><a href="{{ path('category_show', {id: product.category.id}) }}" class="text-decoration-none text-muted">{{ product.category.name }}</a></p>
        {% endif %}
    </div>

    <div class="product-detail-card">
        <div class="row g-4 align-items-stretch">
            <div class="col-12 col-lg-6">
                <div class="product-detail-card__image">
                    <img src="{{ product.image }}" alt="{{ product.name }}" class="img-fluid">
                </div>
            </div>
            <div class="col-12 col-lg-6">
                <div class="product-detail-card__content h-100">
                    <p class="product-card__category">{{ product.price }} DT</p>
                    <p class="product-detail-card__lead">Un produit simple, lisible et présenté sans surcharge visuelle.</p>
                    <p class="product-detail-card__description">{{ product.description }}</p>

                    <div class="d-flex flex-column flex-sm-row gap-3 mt-4">
                        <form method="post" action="{{ path('cart_add', {id: product.id}) }}" class="m-0">
                            <input type="hidden" name="_token" value="{{ csrf_token('cart_add_' ~ product.id) }}">
                            <button type="submit" class="btn btn-brand">Ajouter au panier</button>
                        </form>
                        <a href="{{ path('product_index') }}" class="btn btn-brand">Retour aux produits</a>
                        <a href="{{ path('home') }}" class="btn btn-outline-light">Retour à l’accueil</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
