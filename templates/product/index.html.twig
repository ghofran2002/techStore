{% extends 'base.html.twig' %}

{% block title %}Tous les produits{% endblock %}

{% block body %}
    <div class="section-heading section-heading--compact">
        <p class="eyebrow">Catalogue</p>
        <h1>Liste des produits</h1>
        <p>Chaque fiche met en avant l’essentiel pour comparer rapidement.</p>
    </div>

    <div class="row g-4">
            {% for product in products %}
                <div class="col-12 col-md-6 col-xl-4">
                    <article class="card product-card h-100">
                        <div class="product-card__media product-card__media--tall">
                            <img src="{{ product.image }}" class="card-img-top" alt="{{ product.name }}">
                        </div>
                        <div class="card-body d-flex flex-column">
                            <p class="product-card__category mb-2">{{ product.category ? product.category.name : 'En stock' }}</p>
                            <h2 class="h5 card-title mb-2">
                                <a href="{{ path('product_show', {id: product.id}) }}" class="text-reset text-decoration-none">{{ product.name }}</a>
                            </h2>
                            <p class="product-card__price mb-4">{{ product.price }} DT</p>
                            <div class="d-flex flex-column gap-2 mt-auto">
                                <a href="{{ path('product_show', {id: product.id}) }}" class="btn btn-brand">Voir le produit</a>
                                <form method="post" action="{{ path('cart_add', {id: product.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cart_add_' ~ product.id) }}">
                                    <button type="submit" class="btn btn-outline-light w-100">Ajouter au panier</button>
                                </form>
                            </div>
                        </div>
                    </article>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="empty-state text-center">
                        <h3>Aucun produit disponible</h3>
                        <p class="mb-0">Ajoute un produit en base pour voir le catalogue se remplir.</p>
                    </div>
                </div>
            {% endfor %}
    </div>
{% endblock %}
