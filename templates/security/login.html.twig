{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="auth-shell mx-auto">
        <div class="section-heading section-heading--compact text-start">
            <p class="eyebrow">Accès sécurisé</p>
            <h1>Connexion</h1>
            <p>Retrouve ton espace et continue ton parcours d’achat.</p>
        </div>

        {% if error %}
            <div class="alert alert-danger border-0 shadow-sm">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <div class="auth-card">
            <form method="post" class="auth-form">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="mb-3">
                    <label for="inputEmail" class="form-label">Email</label>
                    <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control form-control-lg" required autofocus>
                </div>

                <div class="mb-4">
                    <label for="inputPassword" class="form-label">Mot de passe</label>
                    <input type="password" name="password" id="inputPassword" class="form-control form-control-lg" required>
                </div>

                <button type="submit" class="btn btn-brand btn-lg w-100">Se connecter</button>

                <div class="mt-3 text-center small">
                    <a href="{{ path('app_register') }}">Pas encore de compte ? S’inscrire</a>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
